# Unix LF, без кавычек. Пример:
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_OWNER_ID=987654321
# TELEGRAM_CHAT_ID=987654321
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
# Авто-админы по username (без @), через запятую
TELEGRAM_AUTO_ADMIN_USERNAMES=shmidt01
# false — только webhook (после HTTPS). По умолчанию polling, если webhook пустой.
# TELEGRAM_USE_POLLING=false

# ── Продажа гайда через ЮKassa ──────────────────────────
# Кабинет ЮKassa → магазин (shopId) и секретный ключ. Без них покупка отключена.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Цена в рублях (на странице показывается 2000 ₽)
GUIDE_PRICE_RUB=2000
# Ставка НДС для чека: 1 = «без НДС» (самозанятые/НПД), 2 = 0%, 3 = 10%, 4 = 20%
GUIDE_VAT_CODE=1
# true — бот спрашивает email для чека (54-ФЗ). false — без чека.
GUIDE_REQUIRE_EMAIL=true
# Куда вернуть покупателя после оплаты (лучше — ссылка на бота t.me/<bot>)
GUIDE_RETURN_URL=https://shmidt01.ru/guide/?paid=1
# В кабинете ЮKassa настроить HTTP-уведомление payment.succeeded →
#   https://shmidt01.ru/api/payments/yookassa

# ── Админ-панель (shmidt01.ru/admin) ────────────────────
# Пароль входа. Пусто — панель отключена (отдаёт 503).
ADMIN_PASSWORD=
# Секрет для подписи cookie-сессии. Если пусто — подписывается паролем.
# Сменить → разлогинит все сессии. Любая длинная случайная строка.
ADMIN_SESSION_SECRET=
