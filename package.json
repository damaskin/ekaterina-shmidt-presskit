{
  "name": "ekaterina-shmidt-presskit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "build:ghpages": "tsc -b && vite build --mode ghpages && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "assets:portrait-desktop": "node scripts/generate-portrait-desktop.mjs",
    "assets:logo-transparent": "node scripts/remove-logo-background.mjs",
    "assets:logo-svg": "node scripts/trace-logo-svg.mjs",
    "assets:favicon": "node scripts/generate-favicon.mjs",
    "deploy:booking": "wrangler deploy",
    "worker:dev": "wrangler dev",
    "d1:create": "wrangler d1 create ekaterina-shmidt-booking",
    "d1:migrate:local": "wrangler d1 migrations apply ekaterina-shmidt-booking --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ekaterina-shmidt-booking --remote",
    "bot:webhook": "node scripts/setup-telegram-webhook.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "potrace": "^2.1.8",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-compression": "^0.5.1",
    "wrangler": "^4.0.0"
  }
}
